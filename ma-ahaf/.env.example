# Copy this file to  .env  and fill in real values. NEVER commit .env or a real key.

# ---- LLM ----
OPENAI_API_KEY=sk-replace-with-your-key

MAAHAF_LLM__PROVIDER=openai            # openai | local | hf | mock
MAAHAF_LLM__GENERATOR_MODEL=gpt-4o-mini
MAAHAF_LLM__VERIFIER_MODEL=gpt-4o-mini
MAAHAF_LLM__DECOMPOSER_MODEL=gpt-4o-mini
MAAHAF_LLM__REVISER_MODEL=gpt-4o-mini
MAAHAF_LLM__EXPANDER_MODEL=gpt-4o-mini
MAAHAF_LLM__JUDGE_MODEL=gpt-4o
MAAHAF_LLM__LOCAL_BASE_URL=http://localhost:11434/v1

# ---- Database / cache ----
MAAHAF_DATABASE_URL=postgresql+psycopg://maahaf:maahaf@db:5432/maahaf
MAAHAF_REDIS_URL=redis://redis:6379/0

# ---- Security (REQUIRED in prod: set a strong random JWT secret, rotate keys) ----
MAAHAF_JWT_SECRET=CHANGE-ME-64-random-hex-chars
MAAHAF_DEV_API_KEY=dev-key             # disabled automatically when MAAHAF_ENV=prod
MAAHAF_ALLOW_EXTERNAL_RETRIEVAL=false
MAAHAF_PII_REDACTION=true

# ---- Models (HuggingFace ids, used for embeddings/rerank/NLI regardless of LLM provider) ----
MAAHAF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MAAHAF_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAAHAF_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
MAAHAF_ZEROSHOT_MODEL=facebook/bart-large-mnli
HF_HOME=/data/models

# ---- Runtime ----
MAAHAF_ENV=dev                        # dev | staging | prod
MAAHAF_LOG_LEVEL=INFO
MAAHAF_MAX_REVISION_LOOPS=2
MAAHAF_VERIFIER_LLM_ENABLED=true       # false = NLI-only verification (cheaper)
MAAHAF_RATE_LIMIT_PER_MIN=60
MAAHAF_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
MAAHAF_OTEL_ENABLED=true
MAAHAF_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
